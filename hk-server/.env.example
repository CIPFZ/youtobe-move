WORK_DIR=runtime
METADATA_DIRNAME=metadata
COOKIE_FILE=
YTDLP_PROXY=
PLAYLIST_STRATEGY=first
YTDLP_VIDEO_FORMAT=bestvideo[ext=mp4][vcodec^=avc1]/bestvideo[ext=mp4]/bestvideo
YTDLP_AUDIO_FORMAT=bestaudio[ext=m4a]/bestaudio
FFMPEG_PATH=

# ── discovery ──
DISCOVERY_ENABLED=true
YOUTUBE_API_KEY=
DISCOVERY_TOPIC_TYPES=pets,beauty,funny
DISCOVERY_TOPIC_PETS_KEYWORDS=cute pets,funny cats,funny dogs,pet compilation,animals,cute animals,dog videos,cat videos
DISCOVERY_TOPIC_PETS_LANGUAGES=
DISCOVERY_TOPIC_BEAUTY_KEYWORDS=beauty,makeup tutorial,fashion,skincare,outfit,hairstyle,beauty tips
DISCOVERY_TOPIC_BEAUTY_LANGUAGES=
DISCOVERY_TOPIC_FUNNY_KEYWORDS=funny videos,comedy,pranks,fails,viral funny,funny moments,try not to laugh,funny compilation
DISCOVERY_TOPIC_FUNNY_LANGUAGES=
DISCOVERY_DAYS_BACK=7
DISCOVERY_MAX_RESULTS_PER_KEYWORD=15
DISCOVERY_TOP_N=5
DISCOVERY_MIN_VIEWS=10000
DISCOVERY_MIN_COMMENTS=10
DISCOVERY_MIN_DURATION_SEC=60
DISCOVERY_MAX_DURATION_SEC=1800
DISCOVERY_HTTP_RETRIES=3
DISCOVERY_HTTP_RETRY_BACKOFF_SEC=1.2
DISCOVERY_DB_PATH=runtime/discovery/discovery.db
DISCOVERY_INTERVAL_MINUTES=1440
DISCOVERY_DOWNLOAD_MIN_SCORE=5.0

# ── download storage ──
DOWNLOAD_MEDIA_DIR=runtime/downloads
DISK_MAX_STORAGE_GB=50.0
DISK_MAX_RETENTION_DAYS=7

# ── api server (empty token = no auth) ──
API_TOKEN=
API_HOST=0.0.0.0
API_PORT=8503

# ── logging ──
LOG_LEVEL=INFO
LOG_FILE=runtime/logs/hk-server.log
