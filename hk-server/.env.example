# Base directory for downloaded files. Each video is stored under OUTPUT_DIR/<video_id>/.
OUTPUT_DIR=runtime/downloads

# yt-dlp format selector for the video-only file.
VIDEO_FORMAT=bestvideo

# yt-dlp format selector for the audio-only file.
AUDIO_FORMAT=bestaudio

# Optional proxy for yt-dlp and poster download, for example: socks5://127.0.0.1:1080
PROXY=

# Optional cookies file for yt-dlp when YouTube requires session validation.
COOKIE_FILE=

# Network socket timeout in seconds for yt-dlp requests.
SOCKET_TIMEOUT=20

# Retry count for yt-dlp file downloads.
RETRIES=10

# Retry count for yt-dlp fragmented downloads.
FRAGMENT_RETRIES=10

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=DEBUG

# Optional log file path. Empty means console output only.
LOG_FILE=runtime/logs/hk-server.log
