# Base directory for downloaded files. Each video is stored under OUTPUT_DIR/<video_id>/.
OUTPUT_DIR=runtime/downloads

# yt-dlp format selector for the video-only file.
VIDEO_FORMAT=bestvideo[ext=mp4][vcodec^=avc1]/bestvideo[ext=mp4]/bestvideo

# yt-dlp format selector for the audio-only file.
AUDIO_FORMAT=bestaudio[ext=m4a]/bestaudio

# Optional proxy for yt-dlp and poster download, for example: socks5://127.0.0.1:1080
PROXY=

# Optional cookies file for yt-dlp when YouTube requires session validation.
COOKIE_FILE=

# Network socket timeout in seconds for yt-dlp requests.
SOCKET_TIMEOUT=20

# Retry count for yt-dlp file downloads.
RETRIES=10

# Retry count for yt-dlp fragmented downloads.
FRAGMENT_RETRIES=10

# Exponential backoff base interval in seconds for retries.
RETRY_BACKOFF_FACTOR=0.5

# YouTube Data API v3 key for metadata lookup and search.
YOUTUBE_API_KEY=

# YouTube Data API v3 base URL.
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3

# YouTube Data API videos endpoint parts.
YOUTUBE_VIDEO_PARTS=snippet,contentDetails,statistics,status,topicDetails

# YouTube Data API search endpoint part.
YOUTUBE_SEARCH_PART=snippet

# YouTube Data API search type.
YOUTUBE_SEARCH_TYPE=video

# YouTube Data API search result ordering.
YOUTUBE_SEARCH_ORDER=relevance

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=DEBUG

# Optional log file path. Empty means console output only.
LOG_FILE=runtime/logs/hk-server.log
