[Unit]
Description=hk-server YouTube discovery and download service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ytq/work/youtobe-move/hk-server
EnvironmentFile=/home/ytq/work/youtobe-move/hk-server/.env
Environment=PYTHONUNBUFFERED=1
Environment=HK_SERVER_VENV=/home/ytq/work/youtobe-move/hk-server/.venv
ExecStart=/bin/bash -lc 'exec "$HK_SERVER_VENV/bin/hk-server"'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
