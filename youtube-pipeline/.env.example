# Base directory for downloaded files. Each video is stored under OUTPUT_DIR/<video_id>/.
OUTPUT_DIR=runtime/downloads

# SQLite database path.
DB_PATH=runtime/data/pipeline.db

# Temporary working directory for future atomic downloads and jobs.
TMP_DIR=runtime/tmp

# yt-dlp format selector for the video-only file.
VIDEO_FORMAT=bestvideo[ext=mp4][vcodec^=avc1]/bestvideo[ext=mp4]/bestvideo

# yt-dlp format selector for the audio-only file.
AUDIO_FORMAT=bestaudio[ext=m4a]/bestaudio

# Optional proxy for yt-dlp and poster download, for example: socks5://127.0.0.1:1080
PROXY=

# Optional cookies file for yt-dlp when YouTube requires session validation.
COOKIE_FILE=

# Network socket timeout in seconds for yt-dlp requests.
SOCKET_TIMEOUT=20

# Retry count for yt-dlp file downloads.
RETRIES=10

# Retry count for yt-dlp fragmented downloads.
FRAGMENT_RETRIES=10

# Exponential backoff base interval in seconds for retries.
RETRY_BACKOFF_FACTOR=0.5

# YouTube Data API v3 key for metadata lookup and search.
YOUTUBE_API_KEY=

# YouTube Data API v3 base URL.
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3

# YouTube Data API videos endpoint parts.
YOUTUBE_VIDEO_PARTS=snippet,contentDetails,statistics,status,topicDetails

# YouTube Data API search endpoint part.
YOUTUBE_SEARCH_PART=snippet

# YouTube Data API search type.
YOUTUBE_SEARCH_TYPE=video

# YouTube Data API search result ordering.
YOUTUBE_SEARCH_ORDER=relevance

# ffmpeg executable path or command name.
FFMPEG_BIN=ffmpeg

# social-auto-upload directory used only for Bilibili publishing.
SOCIAL_AUTO_UPLOAD_DIR=../social-auto-upload

# Bilibili account name. Requires social-auto-upload/cookies/bilibili_<account>.json.
BILIBILI_ACCOUNT=mybili

# Default Bilibili category id. Use 27 for animation/general.
BILIBILI_TID=27

# Allowed Bilibili category options for LLM tid selection, format: tid:name,tid:name
BILIBILI_TID_OPTIONS=27:动画-综合,47:动画-短片手书配音,217:动物圈,75:动物综合,138:生活-搞笑,160:生活,21:生活-日常,188:科技,95:数码,230:软件应用,231:计算机技术,155:时尚,157:美妆护肤,161:手工,162:绘画,23:电影,177:纪录片,5:娱乐,71:综艺,3:音乐,130:音乐综合,213:美食测评

# MiniMax Anthropic-compatible LLM endpoint.
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# MiniMax API key. Keep real value only in .env.
MINIMAX_ANTHROPIC_API_KEY=

# MiniMax model.
MINIMAX_ANTHROPIC_MODEL=MiniMax-M3

# Anthropic-compatible API version header.
MINIMAX_ANTHROPIC_VERSION=2023-06-01

# LLM request timeout in seconds.
MINIMAX_REQUEST_TIMEOUT=60

# LLM max output tokens.
MINIMAX_MAX_TOKENS=800

# Worker loop sleep interval in seconds.
WORKER_INTERVAL_SECONDS=300

# Whether worker-run/worker may run discovery before download/describe.
WORKER_ENABLE_DISCOVERY=true

# Run discovery when queued work is below this count.
WORKER_DISCOVERY_MIN_QUEUE_SIZE=3

# Optional discovery source type for worker discovery: search, trending, channel_uploads. Empty means all sources.
WORKER_DISCOVERY_SOURCE=

# Whether worker-run/worker may execute real publish jobs.
WORKER_ENABLE_PUBLISH=false

# If publish is enabled, keep uploads as dry-run when this is true.
WORKER_PUBLISH_DRY_RUN=true

# Base delay in seconds for automatic retryable job failures.
JOB_RETRY_BASE_SECONDS=300

# Maximum delay in seconds for automatic retryable job failures.
JOB_RETRY_MAX_SECONDS=7200

# Publish mode for automatic publish-next/worker publish:
# manual = never auto publish; approved_auto = only approved drafts; full_auto = any valid non-fallback draft.
PUBLISH_MODE=manual

# Minimum seconds between automatic real publishes. Use 0 to disable.
PUBLISH_MIN_INTERVAL_SECONDS=3600

# Maximum automatic real publishes per local day. Use 0 to disable.
PUBLISH_DAILY_LIMIT=3

# Automatic publish window start in local HH:MM. Empty means no lower bound.
PUBLISH_WINDOW_START=09:00

# Automatic publish window end in local HH:MM. Empty means no upper bound.
PUBLISH_WINDOW_END=23:00

# Web management UI host.
WEB_HOST=127.0.0.1

# Web management UI port.
WEB_PORT=8505

# Discovery sources. Supported source types:
# - search: {"type":"search","keyword":"animated short film","order":"relevance","max_results":5}
# - trending: {"type":"trending","region_code":"US","video_category_id":"1","max_results":10}
# - channel_uploads: {"type":"channel_uploads","channel_id":"UC...","max_results":5}
# - channel_uploads: {"type":"channel_uploads","handle":"@youtubecreators","max_results":5}
DISCOVERY_SOURCES_JSON=[{"type":"search","name":"animated-short","keyword":"animated short film","order":"relevance","max_results":2},{"type":"search","name":"cgi-short","keyword":"CGI animated short film","order":"relevance","max_results":2},{"type":"trending","name":"us-animation-trending","region_code":"US","video_category_id":"1","max_results":2},{"type":"channel_uploads","name":"cgmeetup","channel_id":"UCrSvhrtUgpZT3EU0x1Zoy-w","max_results":2}]

# Default max results per discovery source when source does not specify max_results.
DISCOVERY_MAX_RESULTS_PER_SOURCE=2

# Minimum duration in seconds for discovered videos. Use 0 to disable.
DISCOVERY_MIN_DURATION_SECONDS=60

# Maximum duration in seconds for discovered videos. Use 0 to disable.
DISCOVERY_MAX_DURATION_SECONDS=900

# Minimum view count for discovered videos. Use 0 to disable.
DISCOVERY_MIN_VIEW_COUNT=10000

# Case-insensitive title blocklist, comma-separated.
DISCOVERY_TITLE_BLOCKLIST=#shorts,full episode,reaction,trailer,compilation

# Channel allowlist, comma-separated. Match channel id or channel title. Empty means allow all.
DISCOVERY_CHANNEL_ALLOWLIST=

# Channel blocklist, comma-separated. Match channel id or channel title.
DISCOVERY_CHANNEL_BLOCKLIST=

# YouTube category id allowlist, comma-separated. Empty means allow all.
DISCOVERY_CATEGORY_ALLOWLIST=1,22,24,29

# YouTube category id blocklist, comma-separated.
DISCOVERY_CATEGORY_BLOCKLIST=

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=DEBUG

# Optional log file path. Empty means console output only.
LOG_FILE=runtime/logs/youtube-pipeline.log
